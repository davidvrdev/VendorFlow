# VendorFlow environment variables — PLACEHOLDERS ONLY. Copy to .env (gitignored) and fill locally.
# Never commit real values.

# --- Database (local docker compose defaults; prod: Supabase connection) ---
POSTGRES_DB=vendorflow
POSTGRES_USER=vendorflow
POSTGRES_PASSWORD=vendorflow-local
DATABASE_URL=jdbc:postgresql://localhost:5432/vendorflow
DATABASE_USERNAME=vendorflow
DATABASE_PASSWORD=vendorflow-local

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:3000
# HMAC secret used to hash IP addresses in audit events (>= 32 chars; prod refuses to start otherwise)
APP_IP_HASH_SECRET=replace-with-random-64-chars
# Regex of proxy IPs allowed to set X-Forwarded-For (Tomcat RemoteIpValve). Default: loopback + private ranges.
# Set it to your real proxy addresses in production (docs/SECURITY.md section 9).
# TRUSTED_PROXIES_REGEX=   (leave commented to use the default; an empty value would trust no proxy)

# --- Storage (prod: Supabase Storage S3 endpoint) ---
# filesystem (local/tests) or s3 (prod: Supabase Storage, private bucket, path-style). Prod refuses filesystem unless the opt-in below.
STORAGE_PROVIDER=filesystem
STORAGE_ALLOW_FILESYSTEM_IN_PROD=false
STORAGE_FILESYSTEM_ROOT=./storage-data
# Malware scanner for uploads: noop | clamav. Prod refuses noop unless STORAGE_ALLOW_NOOP_SCANNER_IN_PROD=true.
STORAGE_SCANNER=noop
STORAGE_ALLOW_NOOP_SCANNER_IN_PROD=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=
# e.g. eu-central-1
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Email: EMAIL_PROVIDER=logging (default; delivers nothing, logs only ids) or resend (needs the two values below) ---
# Prod REFUSES to start with logging. Real sending is unverified until the owner provides a key + verified domain.
EMAIL_PROVIDER=logging
RESEND_API_KEY=
EMAIL_FROM=VendorFlow <notifications@example.com>

# --- Stripe (test mode keys only outside prod) ---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Prod refuses BILLING_ENABLED=false and test keys unless these explicit opt-ins are true (staging only)
VENDORFLOW_BILLING_ALLOW_DISABLED_IN_PROD=false
VENDORFLOW_BILLING_ALLOW_TEST_KEYS_IN_PROD=false

# --- Frontend ---
BACKEND_URL=http://localhost:8080

# --- Ops (prod) ---
# Hikari pool size of the API (default 10)
# DATABASE_POOL_SIZE=10
# scripts/backup-db.sh (run from your machine, never commit)
# BACKUP_DATABASE_URL=postgresql://...
# BACKUP_PASSPHRASE_FILE=~/.vendorflow-backup-passphrase
