# VendorFlow environment variables — PLACEHOLDERS ONLY. Copy to .env (gitignored) and fill locally.
# Never commit real values.

# --- Database (local docker compose defaults; prod: Supabase connection) ---
POSTGRES_DB=vendorflow
POSTGRES_USER=vendorflow
POSTGRES_PASSWORD=vendorflow-local
DATABASE_URL=jdbc:postgresql://localhost:5432/vendorflow
DATABASE_USERNAME=vendorflow
DATABASE_PASSWORD=vendorflow-local

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:3000
# HMAC secret used to hash IP addresses in audit events (any long random string)
APP_IP_HASH_SECRET=replace-with-random-64-chars

# --- Storage (prod: Supabase Storage S3 endpoint) ---
STORAGE_PROVIDER=filesystem
STORAGE_FILESYSTEM_ROOT=./storage-data
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Email (Resend) — empty key => logging sender in local ---
RESEND_API_KEY=
EMAIL_FROM=VendorFlow <notifications@example.com>

# --- Stripe (test mode keys only outside prod) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Frontend ---
BACKEND_URL=http://localhost:8080
